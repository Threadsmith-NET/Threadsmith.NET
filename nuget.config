<?xml version="1.0" encoding="utf-8"?>
<!--
  Threadsmith.NET repo-level NuGet configuration (plan-01 task 9).

  Pins a single package source (nuget.org) so Central Package Management +
  TreatWarningsAsErrors do not trip NU1507 from extra sources defined in
  user/machine NuGet.Config. This file takes precedence over user-level config
  for this repo (https://learn.microsoft.com/nuget/consume-packages/configuring-nuget-behavior).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>