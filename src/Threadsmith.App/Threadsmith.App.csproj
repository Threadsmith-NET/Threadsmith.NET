<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Threadsmith.App</RootNamespace>
    <Description>Threadsmith.NET composition root + process startup (strategy §8).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <ProjectReference Include="..\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\Threadsmith.Telemetry\Threadsmith.Telemetry.csproj" />
    <ProjectReference Include="..\Threadsmith.Persistence\Threadsmith.Persistence.csproj" />
    <ProjectReference Include="..\Threadsmith.Skills\Threadsmith.Skills.csproj" />
    <ProjectReference Include="..\Threadsmith.Models\Threadsmith.Models.csproj" />
    <ProjectReference Include="..\Threadsmith.Models.OpenAiCompatible\Threadsmith.Models.OpenAiCompatible.csproj" />
    <ProjectReference Include="..\Threadsmith.Models.OpenAiCodex\Threadsmith.Models.OpenAiCodex.csproj" />
    <ProjectReference Include="..\Threadsmith.Context\Threadsmith.Context.csproj" />
    <ProjectReference Include="..\Threadsmith.Tools\Threadsmith.Tools.csproj" />
    <ProjectReference Include="..\Threadsmith.DotNet\Threadsmith.DotNet.csproj" />
    <ProjectReference Include="..\Threadsmith.Workspaces\Threadsmith.Workspaces.csproj" />
    <ProjectReference Include="..\Threadsmith.Validation\Threadsmith.Validation.csproj" />
    <ProjectReference Include="..\Threadsmith.Execution\Threadsmith.Execution.csproj" />
    <ProjectReference Include="..\Threadsmith.Hooks\Threadsmith.Hooks.csproj" />
    <ProjectReference Include="..\Threadsmith.Extensions.Runtime\Threadsmith.Extensions.Runtime.csproj" />
    <ProjectReference Include="..\Threadsmith.Tui\Threadsmith.Tui.csproj" />
    <ProjectReference Include="..\Threadsmith.Cli\Threadsmith.Cli.csproj" />
    <ProjectReference Include="..\Threadsmith.Mcp\Threadsmith.Mcp.csproj" />
    <ProjectReference Include="..\Threadsmith.Scripting.Worker\Threadsmith.Scripting.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the documented key catalog so the launch bootstrap can scaffold ~/.threadsmith/config.json from it. -->
    <None Include="..\..\.threadsmith\config.example" CopyToOutputDirectory="PreserveNewest" Link="config.example" />
    <None Include="..\..\.threadsmith\providers.example.json" CopyToOutputDirectory="PreserveNewest" Link="providers.example.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Threadsmith.Architecture.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <ThreadsmithDevelopmentRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ThreadsmithDevelopmentRuntimeIdentifier>
    <ThreadsmithDevelopmentRuntimeIdentifier Condition="'$(ThreadsmithDevelopmentRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ThreadsmithDevelopmentRuntimeIdentifier>
    <ThreadsmithDevelopmentRipgrepStage Condition="'$(ThreadsmithDevelopmentRipgrepStage)' == ''">$(MSBuildThisFileDirectory)../../artifacts/dev-tools/$(ThreadsmithDevelopmentRuntimeIdentifier)/stage</ThreadsmithDevelopmentRipgrepStage>
    <ThreadsmithDevelopmentRipgrepExecutable Condition="$([System.String]::Copy('$(ThreadsmithDevelopmentRuntimeIdentifier)').StartsWith('win-'))">rg.exe</ThreadsmithDevelopmentRipgrepExecutable>
    <ThreadsmithDevelopmentRipgrepExecutable Condition="'$(ThreadsmithDevelopmentRipgrepExecutable)' == ''">rg</ThreadsmithDevelopmentRipgrepExecutable>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ThreadsmithDevelopmentRipgrepStage)/tools/$(ThreadsmithDevelopmentRipgrepExecutable)')">
    <None Include="$(ThreadsmithDevelopmentRipgrepStage)/tools/$(ThreadsmithDevelopmentRipgrepExecutable)"
          Link="tools/$(ThreadsmithDevelopmentRipgrepExecutable)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ThreadsmithDevelopmentRipgrepStage)/third-party/ripgrep/LICENSE-MIT"
          Link="third-party/ripgrep/LICENSE-MIT"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ThreadsmithDevelopmentRipgrepStage)/third-party/ripgrep/UNLICENSE"
          Link="third-party/ripgrep/UNLICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ThreadsmithDevelopmentRipgrepStage)/third-party/ripgrep/SOURCE.json"
          Link="third-party/ripgrep/SOURCE.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>