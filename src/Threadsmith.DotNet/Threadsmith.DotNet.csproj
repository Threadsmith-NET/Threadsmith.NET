<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Threadsmith.DotNet</RootNamespace>
    <Description>Threadsmith.NET Roslyn, MSBuild, NuGet, project graph, symbols, impacts, and semantic edits (strategy §8). Roslyn types do not leak across boundaries unless the consumer is explicitly compiler-aware (§8.1).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\Threadsmith.Models\Threadsmith.Models.csproj" />
    <ProjectReference Include="..\Threadsmith.Context\Threadsmith.Context.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Threadsmith.ModelTooling.Tests" />
  </ItemGroup>

</Project>
