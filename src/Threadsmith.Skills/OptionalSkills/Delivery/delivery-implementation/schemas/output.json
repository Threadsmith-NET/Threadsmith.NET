{
  "type": "object",
  "additionalProperties": false,
  "required": ["succeeded", "status", "response", "artifacts", "questions", "limitations", "finalGate", "completedTasks", "totalTasks"],
  "properties": {
    "succeeded": { "type": "boolean" },
    "status": { "type": "string", "enum": ["complete", "partial", "blocked"] },
    "response": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "artifacts": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "questions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "limitations": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "finalGate": { "type": "string", "enum": ["pass", "fail", "blocked", "notRun"] },
    "completedTasks": { "type": "integer", "minimum": 0, "maximum": 128 },
    "totalTasks": { "type": "integer", "minimum": 0, "maximum": 128 }
  }
}
