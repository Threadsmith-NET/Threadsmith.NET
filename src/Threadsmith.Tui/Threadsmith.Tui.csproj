<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Threadsmith.Tui</RootNamespace>
    <Description>Threadsmith.NET inline conversational terminal, presenters, input, prompts, and projections (strategy §8). Consumes host-owned projections and submits application commands; references no persistence implementations (§8.1). Terminal-library types never appear in core interfaces.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="PrettyPrompt" />
    <PackageReference Include="Spectre.Console" />
    <ProjectReference Include="..\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\Threadsmith.Context\Threadsmith.Context.csproj" />
    <ProjectReference Include="..\Threadsmith.Tools\Threadsmith.Tools.csproj" />
    <ProjectReference Include="..\Threadsmith.Execution\Threadsmith.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Threadsmith.CoreRuntime.Tests" />
    <InternalsVisibleTo Include="Threadsmith.RepositoryLifecycle.Tests" />
    <InternalsVisibleTo Include="Threadsmith.SessionStatus.Tests" />
  </ItemGroup>

</Project>
