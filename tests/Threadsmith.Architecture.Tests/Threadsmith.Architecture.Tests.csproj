<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Threadsmith.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- xUnit v3 native Microsoft Testing Platform runner (strategy §6). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <!--
    Architecture tests reference every product project so the dependency graph
    is part of the build graph. The tests assert the §8.1 dependency-direction
    rules by reflecting over each project's assembly references.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Telemetry\Threadsmith.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Persistence\Threadsmith.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Models\Threadsmith.Models.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Context\Threadsmith.Context.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Tools\Threadsmith.Tools.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.DotNet\Threadsmith.DotNet.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Workspaces\Threadsmith.Workspaces.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Validation\Threadsmith.Validation.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Execution\Threadsmith.Execution.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Extensions.Abstractions\Threadsmith.Extensions.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Extensions.Runtime\Threadsmith.Extensions.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Tui\Threadsmith.Tui.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Cli\Threadsmith.Cli.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Mcp\Threadsmith.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.App\Threadsmith.App.csproj" />
  </ItemGroup>

</Project>
