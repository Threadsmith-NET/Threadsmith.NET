<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Threadsmith.Cli\Threadsmith.Cli.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Execution\Threadsmith.Execution.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Mcp\Threadsmith.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Tools\Threadsmith.Tools.csproj" />
    <ProjectReference Include="..\Threadsmith.Mcp.TestServer\Threadsmith.Mcp.TestServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageMcpServerFixture" AfterTargets="Build">
    <ItemGroup>
      <McpServerFixtureFiles Include="$(MSBuildThisFileDirectory)..\Threadsmith.Mcp.TestServer\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Error Condition="'@(McpServerFixtureFiles)' == ''" Text="The MCP server fixture was not built." />
    <Copy SourceFiles="@(McpServerFixtureFiles)"
          DestinationFiles="@(McpServerFixtureFiles->'$(OutDir)fixtures/mcp-server/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
