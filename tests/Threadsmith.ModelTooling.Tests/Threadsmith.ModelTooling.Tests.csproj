<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <ProjectReference Include="..\..\src\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Models\Threadsmith.Models.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Models.OpenAiCompatible\Threadsmith.Models.OpenAiCompatible.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Execution\Threadsmith.Execution.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.DotNet\Threadsmith.DotNet.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Persistence\Threadsmith.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Telemetry\Threadsmith.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Tools\Threadsmith.Tools.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Tui\Threadsmith.Tui.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Scripting.Worker\Threadsmith.Scripting.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\model\*.sse"
          Link="fixtures\model\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\model\plan46-pi-reasoning-v1.json"
          Link="fixtures\model\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\semantic\**\*"
          Link="fixtures\semantic\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
