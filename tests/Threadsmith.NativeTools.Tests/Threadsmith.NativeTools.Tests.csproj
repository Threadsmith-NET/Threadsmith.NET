    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <ProjectReference Include="..\..\src\Threadsmith.Core\Threadsmith.Core.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.DotNet\Threadsmith.DotNet.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Execution\Threadsmith.Execution.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Tools\Threadsmith.Tools.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Validation\Threadsmith.Validation.csproj" />
    <ProjectReference Include="..\..\src\Threadsmith.Workspaces\Threadsmith.Workspaces.csproj" />
  </ItemGroup>
</Project>
